<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>User Trip Listing | GlobalTrotter</title>

<style>
:root{
  --secondary:#0f172a;
  --bg:#f4f6fb;
  --border:#cbd5f5;
}

*{
  box-sizing:border-box;
  font-family:"Segoe UI", Arial, sans-serif;
}

body{
  margin:0;
  background:var(--bg);
}

/* Header */
header{
  background:var(--secondary);
  color:white;
  padding:14px 28px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

header h2{
  margin:0;
  font-weight:600;
}

/* Page Wrapper */
.page{
  width:90%;
  max-width:1100px;
  margin:25px auto;
  background:white;
  border-radius:16px;
  box-shadow:0 8px 22px rgba(0,0,0,0.08);
  padding:24px;
}

/* Search Row */
.search-row{
  display:flex;
  gap:10px;
  margin-bottom:20px;
}

.search-row input{
  flex:1;
  padding:10px 12px;
  border-radius:8px;
  border:1px solid var(--border);
}

.search-row button{
  padding:10px 14px;
  border-radius:8px;
  border:1px solid var(--border);
  background:white;
  cursor:pointer;
}

/* Section Title */
.section-title{
  font-size:18px;
  font-weight:600;
  margin:20px 0 10px;
}

/* Trip Card */
.trip-card{
  height:110px;
  border:1px solid var(--border);
  border-radius:14px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:20px;
  margin-bottom:16px;
  background:#fafafa;
}

/* Responsive */
@media(max-width:700px){
  .search-row{
    flex-direction:column;
  }
}
</style>
</head>

<body>

<header>
  <h2>GlobalTrotter</h2>
  <div style="width:36px;height:36px;border-radius:50%;background:#e0e7ff"></div>
</header>

<div class="page">

  <!-- Search & Filters -->
  <div class="search-row">
    <input placeholder="Search bar ......">
    <button>Group by</button>
    <button>Filter</button>
    <button>Sort by...</button>
  </div>

  <!-- Ongoing -->
  <div class="section-title">Ongoing</div>
  <div class="trip-card">
    Short Over View of the Trip
  </div>

  <!-- Upcoming -->
  <div class="section-title">Up-coming</div>
  <div class="trip-card">
    Short Over View of the Trip
  </div>

  <!-- Completed -->
  <div class="section-title">Completed</div>
  <div class="trip-card">
    Short Over View of the Trip
  </div>

  <div class="trip-card">
    Short Over View of the Trip
  </div>

</div>

</body>
</html>
